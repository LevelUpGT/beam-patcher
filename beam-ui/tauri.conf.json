{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "public/index.html",
    "distDir": "public",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Beam Patcher",
    "version": "1.0.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://goatmmo.com/**",
          "https://**",
          "http://**"
        ]
      },
      "fs": {
        "all": false,
        "readFile": true,
        "scope": [
          "$RESOURCE/**",
          "$RESOURCE/assets/**"
        ]
      },
      "protocol": {
        "all": false,
        "asset": true,
        "assetScope": [
          "$RESOURCE/**",
          "$RESOURCE/assets/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "unminimize": true,
        "startDragging": true
      }
    },
    "bundle": {
      "active": false,
      "icon": [
        "icons/icon.ico"
      ],
      "identifier": "com.beampatcher.app",
      "targets": "all",
      "resources": [
        "public/assets/*"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://patch.example.com/updates/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "YOUR_UPDATER_PUBLIC_KEY_HERE"
    },
    "windows": [
      {
        "title": "LevelUp Games Beam QA (TEST ONLY)",
        "width": 900,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "decorations": false
      }
    ]
  }
}
