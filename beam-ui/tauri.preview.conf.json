{
  "build": {
    "devPath": "preview-web/index.html",
    "distDir": "preview-web",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "BEAM Patcher Preview",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "gt.levelup.beam.preview",
      "icon": [
        "icons/icon.ico"
      ],
      "targets": "all"
    },
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'none'"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "BEAM Patcher | LevelUpGT — Güvenli Önizleme",
        "width": 1016,
        "height": 680,
        "resizable": false,
        "fullscreen": false,
        "decorations": true
      }
    ]
  }
}
